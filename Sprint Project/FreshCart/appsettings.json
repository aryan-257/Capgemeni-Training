{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=FreshCartDb;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "FreshCart",
    "Audience": "FreshCartUsers",
    "ExpiryMinutes": 15
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://localhost:4200"
  ],
  "ExternalServices": {
    "Stripe": {
      "PublishableKey": "pk_test_your_stripe_publishable_key",
      "SecretKey": "sk_test_your_stripe_secret_key",
      "WebhookSecret": "whsec_your_webhook_secret"
    },
    "SendGrid": {
      "ApiKey": "your_sendgrid_api_key",
      "FromEmail": "noreply@freshcart.com",
      "FromName": "FreshCart"
    },
    "Twilio": {
      "AccountSid": "your_twilio_account_sid",
      "AuthToken": "your_twilio_auth_token",
      "FromPhoneNumber": "+1234567890"
    },
    "GoogleMaps": {
      "ApiKey": "your_google_maps_api_key"
    },
    "AzureStorage": {
      "ConnectionString": "your_azure_storage_connection_string",
      "ContainerName": "freshcart-media"
    }
  },
  "SmartCart": {
    "MLServiceUrl": "http://localhost:8000",
    "CacheExpiryMinutes": 30
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/freshcart-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
