@model List<Ecommerce_Inventory.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var total = Model.Sum(item => item.Price * item.Quantity);
}

<div class="container">
    <h1 class="mb-4">Shopping Cart</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4>Your cart is empty</h4>
            <p>Start shopping to add items to your cart.</p>
            <a asp-action="Index" class="btn btn-primary">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var item in Model)
                {
                    <div class="card mb-3">
                        <div class="row g-0">
                            <div class="col-md-3">
                                <img src="@item.ImageUrl" class="img-fluid rounded-start" alt="@item.ProductName">
                            </div>
                            <div class="col-md-9">
                                <div class="card-body">
                                    <h5 class="card-title">@item.ProductName</h5>
                                    <p class="card-text"><strong>₹@item.Price.ToString("N2")</strong></p>
                                    <div class="d-flex align-items-center">
                                        <form asp-action="UpdateQuantity" method="post" class="d-inline me-3">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <label class="me-2">Quantity:</label>
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="10" class="form-control d-inline-block" style="width: 80px;" onchange="this.form.submit()" />
                                        </form>
                                        <form asp-action="RemoveFromCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                        </form>
                                    </div>
                                    <p class="card-text mt-2"><small class="text-muted">Subtotal: ₹@((item.Price * item.Quantity).ToString("N2"))</small></p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Order Summary</h5>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items (@Model.Sum(i => i.Quantity)):</span>
                            <span>₹@total.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span>Free</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong>₹@total.ToString("N2")</strong>
                        </div>
                        <a asp-action="Checkout" class="btn btn-primary w-100 mb-2">Proceed to Checkout</a>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
