@model List<Ecommerce_Inventory.Models.Product>

@{
    ViewData["Title"] = "Shop";
    var category = ViewBag.Category as string ?? "All";
}

<div class="container">
    <h1 class="mb-4">Shop Our Collection</h1>
    
    <!-- Category Filter -->
    <div class="mb-4">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-category="All" class="btn @(category == "All" ? "btn-primary" : "btn-outline-primary")">All Products</a>
            <a asp-action="Index" asp-route-category="Men" class="btn @(category == "Men" ? "btn-primary" : "btn-outline-primary")">Men's Clothes</a>
            <a asp-action="Index" asp-route-category="Women" class="btn @(category == "Women" ? "btn-primary" : "btn-outline-primary")">Women's Clothes</a>
            <a asp-action="Index" asp-route-category="Kids" class="btn @(category == "Kids" ? "btn-primary" : "btn-outline-primary")">Kids' Clothes</a>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 product-card">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">@product.Category</span>
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text"><strong>₹@product.Price.ToString("N2")</strong></p>
                        <p class="card-text text-muted small">Stock: @product.Stock</p>
                        <div class="mt-auto">
                            <form asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-outline-primary btn-sm me-2">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>
                            <a href="#" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#buyModal@(product.Id)">
                                <i class="bi bi-bag-check"></i> Buy Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buy Now Modal -->
            <div class="modal fade" id="buyModal@(product.Id)" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Quick Purchase</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <h6>@product.Name</h6>
                            <p>Price: ₹@product.Price.ToString("N2")</p>
                            <p>@product.Description</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-primary">Add to Cart & Checkout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
