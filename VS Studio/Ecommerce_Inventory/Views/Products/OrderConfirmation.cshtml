@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle text-success" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                    </div>
                    <h1 class="text-success">Order Placed Successfully!</h1>
                    <p class="lead mt-3">Thank you for your purchase.</p>
                    <p>Your order has been received and is being processed.</p>
                    <p class="text-muted">You will receive a confirmation email shortly.</p>
                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-primary me-2">Continue Shopping</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
