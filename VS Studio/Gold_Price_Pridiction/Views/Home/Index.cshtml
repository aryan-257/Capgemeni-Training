@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold mb-4">
        <i class="bi bi-graph-up text-primary"></i> Gold & Silver Price Predictor
    </h1>
    <p class="lead text-muted mb-5">
        Harness the power of Artificial Intelligence to predict precious metal prices
    </p>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h3 class="mb-4">Powered by Machine Learning</h3>
                    <p class="text-muted mb-4">
                        Our advanced LSTM neural network analyzes historical market data to provide 
                        accurate price predictions for Gold and Silver. Get insights backed by AI technology.
                    </p>
                    <a asp-controller="Prediction" asp-action="Index" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-lightning-charge-fill"></i> Start Predicting Now
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-primary mb-3">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <h5 class="card-title">AI-Powered</h5>
                    <p class="card-text text-muted">
                        Advanced LSTM neural networks trained on years of market data
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-success mb-3">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h5 class="card-title">Real-Time Results</h5>
                    <p class="card-text text-muted">
                        Get instant predictions with confidence scores in seconds
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-info mb-3">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="card-title">Reliable & Secure</h5>
                    <p class="card-text text-muted">
                        Built with industry-standard security and best practices
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
