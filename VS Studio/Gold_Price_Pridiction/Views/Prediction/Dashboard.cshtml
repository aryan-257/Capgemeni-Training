@{
    ViewData["Title"] = "Prediction Dashboard";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold">
                    <i class="bi bi-speedometer2"></i> Prediction Dashboard
                </h1>
                <p class="lead text-muted">
                    Real-time insights and analytics for Gold & Silver predictions
                </p>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-4 mb-5">
                <!-- Gold Card -->
                <div class="col-md-6">
                    <div class="card shadow-lg border-0 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="flex-shrink-0">
                                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                        <i class="bi bi-coin fs-1 text-warning"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h3 class="mb-0">Gold</h3>
                                    <p class="text-muted mb-0">Precious Metal</p>
                                </div>
                            </div>
                            <div class="mt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Current Trend</span>
                                    <span class="badge bg-success">
                                        <i class="bi bi-arrow-up"></i> Bullish
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Model Accuracy</span>
                                    <span class="fw-bold text-success">94%</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Avg Confidence</span>
                                    <span class="fw-bold">89%</span>
                                </div>
                            </div>
                            <div class="mt-4">
                                <a asp-action="Index" class="btn btn-warning w-100">
                                    <i class="bi bi-graph-up-arrow"></i> Predict Gold Price
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Silver Card -->
                <div class="col-md-6">
                    <div class="card shadow-lg border-0 h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="flex-shrink-0">
                                    <div class="bg-secondary bg-opacity-10 rounded-circle p-3">
                                        <i class="bi bi-gem fs-1 text-secondary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h3 class="mb-0">Silver</h3>
                                    <p class="text-muted mb-0">Precious Metal</p>
                                </div>
                            </div>
                            <div class="mt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Current Trend</span>
                                    <span class="badge bg-info">
                                        <i class="bi bi-arrow-right"></i> Stable
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Model Accuracy</span>
                                    <span class="fw-bold text-success">91%</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Avg Confidence</span>
                                    <span class="fw-bold">86%</span>
                                </div>
                            </div>
                            <div class="mt-4">
                                <a asp-action="Index" class="btn btn-secondary w-100">
                                    <i class="bi bi-graph-up-arrow"></i> Predict Silver Price
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comparison Chart -->
            <div class="card shadow-lg border-0 mb-5">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-bar-chart-line"></i> Gold vs Silver - 30 Day Trend (INR per kg)
                    </h4>
                </div>
                <div class="card-body p-4">
                    <canvas id="comparisonChart" height="80"></canvas>
                    <p class="text-muted text-center mt-3 small mb-0">
                        <i class="bi bi-info-circle"></i> Prices shown in Indian Rupees (₹) per kilogram | Exchange Rate: 1 USD = ₹83.12
                    </p>
                </div>
            </div>

            <!-- Model Information -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="card shadow border-0 h-100">
                        <div class="card-body text-center p-4">
                            <div class="display-4 text-primary mb-3">
                                <i class="bi bi-cpu"></i>
                            </div>
                            <h5 class="card-title">LSTM Neural Network</h5>
                            <p class="card-text text-muted">
                                3-layer deep learning model with 50 units per layer
                            </p>
                            <div class="mt-3">
                                <span class="badge bg-primary">TensorFlow</span>
                                <span class="badge bg-info">Keras</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow border-0 h-100">
                        <div class="card-body text-center p-4">
                            <div class="display-4 text-success mb-3">
                                <i class="bi bi-database"></i>
                            </div>
                            <h5 class="card-title">Training Data</h5>
                            <p class="card-text text-muted">
                                5 years of historical price data with 60-day sequences
                            </p>
                            <div class="mt-3">
                                <span class="badge bg-success">1,800+ Days</span>
                                <span class="badge bg-info">OHLCV Data</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow border-0 h-100">
                        <div class="card-body text-center p-4">
                            <div class="display-4 text-warning mb-3">
                                <i class="bi bi-lightning-charge"></i>
                            </div>
                            <h5 class="card-title">Prediction Speed</h5>
                            <p class="card-text text-muted">
                                Real-time predictions with confidence scores in milliseconds
                            </p>
                            <div class="mt-3">
                                <span class="badge bg-warning">< 100ms</span>
                                <span class="badge bg-info">Real-time</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-lg border-0">
                <div class="card-body p-4">
                    <h4 class="mb-4">
                        <i class="bi bi-lightning-fill"></i> Quick Actions
                    </h4>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                                <i class="bi bi-plus-circle fs-4 d-block mb-2"></i>
                                New Prediction
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
                                <i class="bi bi-house fs-4 d-block mb-2"></i>
                                Home
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="https://www.investing.com/commodities/gold" target="_blank" class="btn btn-outline-info w-100 py-3">
                                <i class="bi bi-graph-up fs-4 d-block mb-2"></i>
                                Live Market Data
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Create comparison chart with INR per kg prices
        const ctx = document.getElementById('comparisonChart').getContext('2d');
        
        // Conversion constants
        const USD_TO_INR = 83.12;
        const GRAMS_PER_OUNCE = 31.1035;
        
        // Function to convert USD per ounce to INR per kg
        function convertToINRPerKg(usdPerOunce) {
            return (usdPerOunce * USD_TO_INR / GRAMS_PER_OUNCE) * 1000;
        }
        
        // Generate 30 days of sample data
        const labels = [];
        const goldData = [];
        const silverData = [];
        
        let goldBaseUSD = 2100;
        let silverBaseUSD = 25;
        
        for (let i = 30; i >= 0; i--) {
            const date = new Date();
            date.setDate(date.getDate() - i);
            labels.push(date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
            
            // Generate realistic price movements in USD
            goldBaseUSD += (Math.random() - 0.5) * 30;
            silverBaseUSD += (Math.random() - 0.5) * 0.5;
            
            // Convert to INR per kg
            goldData.push(convertToINRPerKg(goldBaseUSD).toFixed(2));
            silverData.push(convertToINRPerKg(silverBaseUSD).toFixed(2));
        }
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Gold (₹/kg)',
                        data: goldData,
                        borderColor: 'rgb(255, 193, 7)',
                        backgroundColor: 'rgba(255, 193, 7, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        yAxisID: 'y',
                        pointRadius: 3,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Silver (₹/kg)',
                        data: silverData,
                        borderColor: 'rgb(108, 117, 125)',
                        backgroundColor: 'rgba(108, 117, 125, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        yAxisID: 'y1',
                        pointRadius: 3,
                        pointHoverRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            font: {
                                size: 14,
                                weight: 'bold'
                            },
                            usePointStyle: true,
                            padding: 15
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                let value = parseFloat(context.parsed.y);
                                return context.dataset.label + ': ₹' + value.toLocaleString('en-IN', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Gold Price (₹ per kg)',
                            font: {
                                weight: 'bold',
                                size: 13
                            },
                            color: 'rgb(255, 193, 7)'
                        },
                        ticks: {
                            callback: function(value) {
                                return '₹' + (value / 100000).toFixed(1) + 'L';
                            },
                            font: {
                                size: 11
                            }
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Silver Price (₹ per kg)',
                            font: {
                                weight: 'bold',
                                size: 13
                            },
                            color: 'rgb(108, 117, 125)'
                        },
                        ticks: {
                            callback: function(value) {
                                return '₹' + (value / 1000).toFixed(1) + 'K';
                            },
                            font: {
                                size: 11
                            }
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            minRotation: 45,
                            font: {
                                size: 11
                            }
                        },
                        grid: {
                            display: false
                        }
                    }
                },
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart'
                }
            }
        });
    </script>
}
