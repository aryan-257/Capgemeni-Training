@model Gold_Price_Pridiction.Models.PredictionRequest

@{
    ViewData["Title"] = "Gold & Silver Price Prediction";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Header Section -->
            <div class="text-center mb-4">
                <h1 class="display-4 fw-bold text-primary">
                    <i class="bi bi-graph-up-arrow"></i> AI Price Predictor
                </h1>
                <p class="lead text-muted">
                    Predict future Gold and Silver prices using Machine Learning
                </p>
            </div>

            <!-- Prediction Form Card -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-cpu"></i> Enter Prediction Details
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Index" method="post" id="predictionForm">
                        @* Anti-forgery token for security *@
                        @Html.AntiForgeryToken()

                        @* Display validation summary for errors *@
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Metal Type Selection -->
                        <div class="mb-4">
                            <label asp-for="Metal" class="form-label fw-bold">
                                <i class="bi bi-gem"></i> Select Metal Type
                            </label>
                            <select asp-for="Metal" class="form-select form-select-lg" required>
                                <option value="">-- Choose Metal --</option>
                                <option value="Gold">🥇 Gold</option>
                                <option value="Silver">🥈 Silver</option>
                            </select>
                            <span asp-validation-for="Metal" class="text-danger small"></span>
                        </div>

                        <!-- Prediction Date -->
                        <div class="mb-4">
                            <label asp-for="PredictionDate" class="form-label fw-bold">
                                <i class="bi bi-calendar-event"></i> Prediction Date
                            </label>
                            <input asp-for="PredictionDate" 
                                   type="date" 
                                   class="form-control form-control-lg" 
                                   id="predictionDateInput"
                                   required />
                            <span asp-validation-for="PredictionDate" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Select a date within the next 30 days for price prediction
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg" id="predictBtn">
                                <i class="bi bi-lightning-charge-fill"></i> Predict Price
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info Section -->
            <div class="card mt-4 border-info">
                <div class="card-body">
                    <h6 class="card-title text-info">
                        <i class="bi bi-info-circle-fill"></i> How It Works
                    </h6>
                    <ul class="small mb-0">
                        <li>Our AI model analyzes historical price patterns</li>
                        <li>Uses LSTM neural networks for time-series prediction</li>
                        <li>Provides confidence scores for each prediction</li>
                        <li>Trained on years of market data</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Client-side validation scripts *@
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Add loading state when form is submitted
        document.getElementById('predictionForm').addEventListener('submit', function(e) {
            const btn = document.getElementById('predictBtn');
            const form = this;
            
            // Check if form is valid
            if (!form.checkValidity()) {
                return; // Let browser validation handle it
            }
            
            // Show loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Analyzing with AI...';
            
            // Add loading overlay
            const overlay = document.createElement('div');
            overlay.id = 'loadingOverlay';
            overlay.innerHTML = `
                <div class="loading-content">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h4 class="text-primary">Processing Prediction...</h4>
                    <p class="text-muted">Our AI is analyzing market patterns</p>
                    <div class="progress mt-3" style="width: 300px; height: 8px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                             role="progressbar" 
                             style="width: 100%"></div>
                    </div>
                </div>
            `;
            overlay.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(255, 255, 255, 0.95);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            `;
            overlay.querySelector('.loading-content').style.cssText = `
                text-align: center;
            `;
            document.body.appendChild(overlay);
        });

        // Set date range: today to 30 days from now
        const dateInput = document.getElementById('predictionDateInput');
        const today = new Date();
        const maxDate = new Date();
        maxDate.setDate(today.getDate() + 30);
        
        // Format dates as YYYY-MM-DD
        const todayStr = today.toISOString().split('T')[0];
        const maxDateStr = maxDate.toISOString().split('T')[0];
        
        dateInput.setAttribute('min', todayStr);
        dateInput.setAttribute('max', maxDateStr);
        
        // Set default to tomorrow
        const tomorrow = new Date();
        tomorrow.setDate(today.getDate() + 1);
        const tomorrowStr = tomorrow.toISOString().split('T')[0];
        if (!dateInput.value) {
            dateInput.value = tomorrowStr;
        }
        
        // Add real-time validation feedback
        const metalSelect = document.querySelector('select[name="Metal"]');
        metalSelect.addEventListener('change', function() {
            if (this.value) {
                this.classList.add('is-valid');
                this.classList.remove('is-invalid');
            }
        });
        
        dateInput.addEventListener('change', function() {
            const selectedDate = new Date(this.value);
            const minDate = new Date(todayStr);
            const maxDateLimit = new Date(maxDateStr);
            
            if (selectedDate >= minDate && selectedDate <= maxDateLimit) {
                this.classList.add('is-valid');
                this.classList.remove('is-invalid');
            } else {
                this.classList.add('is-invalid');
                this.classList.remove('is-valid');
                alert('Please select a date within the next 30 days.');
            }
        });
    </script>
}
