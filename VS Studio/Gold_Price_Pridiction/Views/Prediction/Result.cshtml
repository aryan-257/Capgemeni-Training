@model Gold_Price_Pridiction.Models.PredictionResponse

@{
    ViewData["Title"] = "Prediction Result";
    
    // Format price with currency
    var formattedPrice = Model.PredictedPrice.ToString("C2");
    
    // Calculate confidence percentage
    var confidencePercent = (Model.Confidence * 100).ToString("F1");
    
    // Determine confidence level color
    var confidenceClass = Model.Confidence >= 0.8 ? "success" : 
                         Model.Confidence >= 0.6 ? "warning" : "danger";
    
    // Format date
    var dateFormatted = Model.PredictionDate.ToString("MMMM dd, yyyy");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            <!-- Success Animation Header -->
            <div class="text-center mb-4 animate__animated animate__fadeInDown">
                <div class="display-1 text-success mb-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h1 class="display-5 fw-bold">Prediction Complete!</h1>
                <p class="lead text-muted">AI analysis finished successfully</p>
            </div>

            <!-- Main Result Card -->
            <div class="card shadow-lg border-0 mb-4 animate__animated animate__fadeInUp">
                <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0">
                        <i class="bi bi-graph-up"></i> @Model.Metal Price Prediction
                    </h3>
                </div>
                <div class="card-body p-5">
                    
                    <!-- Predicted Price - Main Focus (INR per KG) -->
                    <div class="text-center mb-4 p-4 bg-gradient rounded" style="background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);">
                        <p class="text-muted mb-2">Predicted Price</p>
                        <h1 class="display-2 fw-bold text-success mb-0">
                            ₹@Model.PricePerKgINR.ToString("N2")
                        </h1>
                        <p class="text-muted mt-2">per kilogram (INR)</p>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-info-circle"></i> USD: @formattedPrice per ounce
                        </p>
                    </div>

                    <!-- INR Prices Section - Different Weights -->
                    <div class="alert alert-info mb-4" role="alert">
                        <h5 class="alert-heading mb-3">
                            <i class="bi bi-currency-rupee"></i> Prices for Different Weights
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="card border-0 bg-white shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="mb-2">
                                            <i class="bi bi-gem fs-2 text-warning"></i>
                                        </div>
                                        <h6 class="text-muted mb-2">1 Gram</h6>
                                        <h3 class="text-success mb-0 fw-bold">₹@Model.PricePerGramINR.ToString("N2")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 bg-white shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="mb-2">
                                            <i class="bi bi-gem fs-2 text-warning"></i>
                                        </div>
                                        <h6 class="text-muted mb-2">10 Grams</h6>
                                        <h3 class="text-success mb-0 fw-bold">₹@Model.PricePer10GramINR.ToString("N2")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-0 bg-primary bg-opacity-10 shadow-sm h-100 border border-primary border-2">
                                    <div class="card-body text-center">
                                        <div class="mb-2">
                                            <i class="bi bi-gem fs-2 text-primary"></i>
                                        </div>
                                        <h6 class="text-muted mb-2">1 Kilogram</h6>
                                        <h3 class="text-primary mb-0 fw-bold">₹@Model.PricePerKgINR.ToString("N2")</h3>
                                        <small class="text-muted">(Main Price)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="text-muted small mb-0 mt-3 text-center">
                            <i class="bi bi-info-circle"></i> Exchange Rate: 1 USD = ₹@Model.ExchangeRate | 1 Troy Ounce = 31.1035 grams
                        </p>
                    </div>

                    <hr class="my-4">

                    <!-- Prediction Details Grid -->
                    <div class="row g-4">
                        
                        <!-- Metal Type -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-primary bg-opacity-10 rounded p-3">
                                        <i class="bi bi-gem fs-3 text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Metal Type</h6>
                                    <h4 class="mb-0">@Model.Metal</h4>
                                </div>
                            </div>
                        </div>

                        <!-- Prediction Date -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-info bg-opacity-10 rounded p-3">
                                        <i class="bi bi-calendar-check fs-3 text-info"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Prediction Date</h6>
                                    <h4 class="mb-0">@dateFormatted</h4>
                                </div>
                            </div>
                        </div>

                        <!-- Confidence Score -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-@confidenceClass bg-opacity-10 rounded p-3">
                                        <i class="bi bi-speedometer2 fs-3 text-@confidenceClass"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Confidence Score</h6>
                                    <h4 class="mb-0">@confidencePercent%</h4>
                                    <div class="progress mt-2" style="height: 8px;">
                                        <div class="progress-bar bg-@confidenceClass" 
                                             role="progressbar" 
                                             style="width: @confidencePercent%"
                                             aria-valuenow="@confidencePercent" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Timestamp -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="bg-secondary bg-opacity-10 rounded p-3">
                                        <i class="bi bi-clock-history fs-3 text-secondary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Generated At</h6>
                                    <h4 class="mb-0">@Model.Timestamp.ToLocalTime().ToString("hh:mm tt")</h4>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Confidence Interpretation -->
                    <div class="alert alert-@confidenceClass mt-4" role="alert">
                        <h6 class="alert-heading">
                            <i class="bi bi-lightbulb-fill"></i> Confidence Interpretation
                        </h6>
                        @if (Model.Confidence >= 0.8)
                        {
                            <p class="mb-0">High confidence prediction. The model is very certain about this forecast based on historical patterns.</p>
                        }
                        else if (Model.Confidence >= 0.6)
                        {
                            <p class="mb-0">Moderate confidence. The prediction is reliable but consider market volatility.</p>
                        }
                        else
                        {
                            <p class="mb-0">Lower confidence. Market conditions may be uncertain. Use this prediction with caution.</p>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                        <a asp-action="Index" class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-arrow-repeat"></i> Make Another Prediction
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="bi bi-house-door"></i> Back to Home
                        </a>
                    </div>

                </div>
            </div>

            <!-- Price Trend Visualization -->
            <div class="card shadow-lg border-0 mb-4 animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-graph-up"></i> Price Trend Visualization (INR per kg)
                    </h4>
                </div>
                <div class="card-body p-4">
                    <canvas id="priceChart" height="80"></canvas>
                    <p class="text-muted text-center mt-3 small">
                        <i class="bi bi-info-circle"></i> Chart shows recent price trend and AI prediction in Indian Rupees per kilogram
                    </p>
                </div>
            </div>

            <!-- Disclaimer -->
            <div class="alert alert-warning" role="alert">
                <h6 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i> Disclaimer
                </h6>
                <p class="small mb-0">
                    This prediction is generated by an AI model for educational purposes. 
                    It should not be used as financial advice. Always consult with financial 
                    professionals before making investment decisions.
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add animation library (optional enhancement)
        // You can add animate.css via CDN in _Layout.cshtml for animations
        console.log('Prediction result loaded successfully');
        
        // Create price trend chart with INR per kg
        const ctx = document.getElementById('priceChart').getContext('2d');
        
        // Conversion constants
        const USD_TO_INR = @Model.ExchangeRate;
        const GRAMS_PER_OUNCE = 31.1035;
        
        // Function to convert USD per ounce to INR per kg
        function convertToINRPerKg(usdPerOunce) {
            return (usdPerOunce * USD_TO_INR / GRAMS_PER_OUNCE) * 1000;
        }
        
        // Sample historical data (in production, this would come from the API)
        const predictedPriceUSD = @Model.PredictedPrice;
        const predictedPriceINR = @Model.PricePerKgINR;
        const metal = '@Model.Metal';
        const confidence = @Model.Confidence;
        
        // Generate sample historical prices (last 7 days) in USD, then convert to INR
        const historicalPricesINR = [];
        const basePriceUSD = predictedPriceUSD * 0.98; // Start slightly lower
        for (let i = 6; i >= 0; i--) {
            const variation = (Math.random() - 0.5) * (basePriceUSD * 0.02);
            const priceUSD = basePriceUSD + variation;
            const priceINR = convertToINRPerKg(priceUSD);
            historicalPricesINR.push(priceINR.toFixed(2));
        }
        
        // Add predicted price in INR
        historicalPricesINR.push(predictedPriceINR.toFixed(2));
        
        // Generate labels
        const labels = [];
        for (let i = 7; i > 0; i--) {
            const date = new Date();
            date.setDate(date.getDate() - i);
            labels.push(date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
        }
        labels.push('Predicted');
        
        // Create gradient
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(102, 126, 234, 0.5)');
        gradient.addColorStop(1, 'rgba(118, 75, 162, 0.1)');
        
        // Create chart
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: metal + ' Price (₹/kg)',
                    data: historicalPricesINR,
                    borderColor: 'rgb(102, 126, 234)',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    pointBackgroundColor: function(context) {
                        // Highlight predicted point
                        return context.dataIndex === historicalPricesINR.length - 1 
                            ? 'rgb(220, 53, 69)' 
                            : 'rgb(102, 126, 234)';
                    },
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                let value = parseFloat(context.parsed.y);
                                label += '₹' + value.toLocaleString('en-IN', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                                
                                // Add confidence for predicted point
                                if (context.dataIndex === historicalPricesINR.length - 1) {
                                    label += ' (AI Prediction - ' + (confidence * 100).toFixed(1) + '% confidence)';
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: {
                            callback: function(value) {
                                return '₹' + (value / 100000).toFixed(2) + 'L';
                            },
                            font: {
                                size: 12
                            }
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        },
                        title: {
                            display: true,
                            text: 'Price (₹ per kg)',
                            font: {
                                weight: 'bold',
                                size: 13
                            }
                        }
                    },
                    x: {
                        ticks: {
                            font: {
                                size: 12
                            }
                        },
                        grid: {
                            display: false
                        }
                    }
                },
                animation: {
                    duration: 2000,
                    easing: 'easeInOutQuart'
                }
            }
        });
    </script>
}
