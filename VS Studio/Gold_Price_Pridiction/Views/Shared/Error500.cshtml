@{
    ViewData["Title"] = "Server Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <!-- Error Icon -->
            <div class="mb-4">
                <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 8rem;"></i>
            </div>

            <!-- Error Message -->
            <h1 class="display-1 fw-bold text-danger">500</h1>
            <h2 class="mb-4">Internal Server Error</h2>
            <p class="lead text-muted mb-4">
                Something went wrong on our end. We're working to fix it!
            </p>

            <!-- Error Details -->
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-info-circle"></i>
                <strong>What happened?</strong><br>
                Our server encountered an unexpected error while processing your request.
                The error has been logged and our team will investigate.
            </div>

            <!-- Suggestions -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-tools"></i> Try these steps:
                    </h5>
                    <ul class="list-unstyled text-start">
                        <li class="mb-2">
                            <i class="bi bi-arrow-clockwise text-info"></i> 
                            Refresh the page
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-clock-history text-info"></i> 
                            Wait a few minutes and try again
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-house text-info"></i> 
                            Return to the homepage
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-house-door"></i> Go to Homepage
                </a>
                <button onclick="location.reload()" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-arrow-clockwise"></i> Refresh Page
                </button>
            </div>
        </div>
    </div>
</div>
