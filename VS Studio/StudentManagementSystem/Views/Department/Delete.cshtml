@model StudentManagementSystem.Models.Department
@{
    ViewData["Title"] = "Delete Department";
}

<div class="row">
    <div class="col-md-8">
        <h2>Delete Department</h2>
        <hr />
        <h3>Are you sure you want to delete this?</h3>
        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Department Name</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.DepartmentName)</dd>
                    
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>
                </dl>
            </div>
        </div>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="DepartmentId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>