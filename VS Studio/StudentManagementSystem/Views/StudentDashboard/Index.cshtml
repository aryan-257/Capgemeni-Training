@model StudentManagementSystem.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2>Student Dashboard</h2>
        <hr />
    </div>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">
        <h5>Profile Setup Required</h5>
        <p>@ViewBag.Message</p>
        @if (ViewBag.UserName != null && ViewBag.UserEmail != null)
        {
            <p><strong>Your Account Details:</strong></p>
            <ul>
                <li><strong>Name:</strong> @ViewBag.UserName</li>
                <li><strong>Email:</strong> @ViewBag.UserEmail</li>
            </ul>
            <p>A teacher or administrator needs to create your student profile with course and department information.</p>
        }
    </div>
}
else if (Model != null)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>My Profile</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.StudentName</dd>
                        
                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                        
                        <dt class="col-sm-4">Phone:</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>
                        
                        <dt class="col-sm-4">Address:</dt>
                        <dd class="col-sm-8">@Model.Address</dd>
                    </dl>
                    <a asp-action="UpdateProfile" class="btn btn-primary">Update Profile</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Course Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Department:</dt>
                        <dd class="col-sm-8">@Model.DepartmentName</dd>
                        
                        <dt class="col-sm-4">Course:</dt>
                        <dd class="col-sm-8">@Model.CourseName</dd>
                        
                        <dt class="col-sm-4">Duration:</dt>
                        <dd class="col-sm-8">@Model.Duration</dd>
                        
                        <dt class="col-sm-4">Fees:</dt>
                        <dd class="col-sm-8">$@Model.Fees</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}