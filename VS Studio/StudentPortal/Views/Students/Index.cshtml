@model IEnumerable<StudentPortal.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Students List</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Student
        </a>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" id="searchForm" class="row g-3">
                <div class="col-md-12">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" 
                               name="searchQuery" 
                               id="searchInput"
                               value="@ViewData["CurrentFilter"]" 
                               class="form-control" 
                               placeholder="Search by name, email, or phone..." 
                               autocomplete="off" />
                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                        {
                            <button type="button" class="btn btn-outline-secondary" id="clearBtn">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <div class="col-12">
                        <span class="text-muted">
                            <i class="bi bi-funnel"></i> Filtered by: <strong>@ViewData["CurrentFilter"]</strong>
                        </span>
                    </div>
                }
            </form>
        </div>
    </div>

    <script>
        // Fast real-time search - searches when user stops typing
        let searchTimeout;
        const searchInput = document.getElementById('searchInput');
        const searchForm = document.getElementById('searchForm');
        const clearBtn = document.getElementById('clearBtn');

        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            
            const searchValue = this.value.trim();
            
            // Only search if user has typed at least 2 characters OR if clearing search
            if (searchValue.length >= 2 || searchValue.length === 0) {
                searchTimeout = setTimeout(function() {
                    searchForm.submit();
                }, 400); // Wait 400ms after user stops typing (faster)
            }
        });

        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                searchInput.value = '';
                searchForm.submit();
            });
        }
    </script>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                                <th>@Html.DisplayNameFor(model => model.Email)</th>
                                <th>@Html.DisplayNameFor(model => model.Phone)</th>
                                <th>@Html.DisplayNameFor(model => model.Status)</th>
                                <th>@Html.DisplayNameFor(model => model.JoinDate)</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@Html.DisplayFor(modelItem => item.FullName)</td>
                                    <td>
                                        <i class="bi bi-envelope"></i> @Html.DisplayFor(modelItem => item.Email)
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Phone))
                                        {
                                            <i class="bi bi-telephone"></i> @Html.DisplayFor(modelItem => item.Phone)
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else if (item.Status == "Inactive")
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-event"></i> @item.JoinDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="bi bi-info-circle fs-3"></i>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <p class="mb-0 mt-2">No students found matching "@ViewData["CurrentFilter"]". Try a different search term.</p>
            }
            else
            {
                <p class="mb-0 mt-2">No students found. Click "Add New Student" to get started.</p>
            }
        </div>
    }
</div>
